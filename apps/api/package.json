{
  "name": "@prospectos/api", "private": true, "type": "module", "version": "0.1.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "worker": "tsx src/worker/index.ts",
    "migrate": "tsx src/migrate.ts", "db:setup": "tsx src/migrate.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "typecheck": "tsc -p . --noEmit", "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0", "@fastify/cors": "^9.0.1", "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0", "@vercel/functions": ">=2.0.0", "dotenv": "^16.4.5", "fastify": "^4.28.1",
    "mongodb": "^6.8.0", "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0", "esbuild": "^0.21.5", "tsx": "^4.16.0", "typescript": "^5.5.0", "vitest": "^2.0.0"
  }
}
