# --- Required ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
# MongoDB Atlas (free M0 works): Connect > Drivers > copy the mongodb+srv:// string and put your password in it. Local: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/prospectos?retryWrites=true&w=majority
MONGODB_DB=prospectos      # optional; defaults to the database named in the URI, else "prospectos"
OWNER_EMAIL=you@example.com
SESSION_SECRET=            # 32+ random chars
ENCRYPTION_KEY=            # 32 bytes, base64 (encrypts stored credentials)

# --- Optional: providers disable gracefully if unset ---
GROQ_API_KEY=
GROQ_MODEL=
FOURSQUARE_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
# OpenStreetMap/Overpass needs no key
OWNER_PASSWORD_HASH=       # generate: npm run hash-password -w apps/api

# --- Vercel-only deploy (set these in Vercel > Settings > Environment Variables) ---
# MONGODB_URI: your Atlas connection string. In Atlas > Network Access, allow 0.0.0.0/0 (Vercel has no fixed IPs)
# FRONTEND_URL and VITE_API_URL: leave unset; the web app and API share one origin on Vercel
# CRON_SECRET=<any 16+ char random string>   # optional; enables the daily /api/cron/tick fallback
